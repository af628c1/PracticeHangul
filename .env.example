# Firebase web app config (Firebase console → Project settings → Your apps).
# Copy to .env.local for local development. Leave blank to run without accounts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# true = use local emulators (see README)
VITE_FIREBASE_EMULATORS=false
