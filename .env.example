# Optional overrides for the Firebase config in src/lib/firebaseConfig.ts.
# Copy to .env.local for local development; leave blank to use the built-in project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# true = use local emulators (see README)
VITE_FIREBASE_EMULATORS=false
